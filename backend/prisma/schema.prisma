generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Farms {
  id          Int       @id @default(autoincrement())
  name        String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  description String?   @default("")
  location    String?   @default("")
  size        Float?    @default(0)
  latitude    Float?
  longitude   Float?
  active      Boolean   @default(true)
  animal      Animals[]
  user        Users[]

  @@map("farms")
}

model Users {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  profile_photo String?
  role          String
  farm_id       Int
  active        Boolean        @default(true)
  phone         String?
  address       String?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  farmhand      Farmhands?
  farm          Farms          @relation(fields: [farm_id], references: [id], onDelete: Cascade)
  veterinary    Veterinarians?

  @@index([farm_id])
  @@index([email])
  @@map("users")
}

model Farmhands {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  hire_date  DateTime @default(now())
  salary     Float?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("farmhands")
}

model Veterinarians {
  id               Int            @id @default(autoincrement())
  user_id          Int            @unique
  license_number   String?
  specialization   String?
  years_experience Int?           @default(0)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  application      Applications[]
  user             Users          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("veterinarians")
}

model Animals {
  id              Int            @id @default(autoincrement())
  name            String
  species_id      Int
  breed_id        Int
  birth_date      DateTime
  weight          Float          @default(0)
  health_status   String         @default("HEALTHY")
  gender          String?
  color           String?
  tag_number      String?        @unique
  microchip_id    String?        @unique
  mother_id       Int?
  father_id       Int?
  farm_id         Int
  active          Boolean        @default(true)
  notes           String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  breed           Breeds         @relation(fields: [breed_id], references: [id])
  farm            Farms          @relation(fields: [farm_id], references: [id], onDelete: Cascade)
  species         Species        @relation(fields: [species_id], references: [id], onUpdate: NoAction)
  mother          Animals?       @relation("MotherChildren", fields: [mother_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  father          Animals?       @relation("FatherChildren", fields: [father_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mother_children Animals[]      @relation("MotherChildren")
  father_children Animals[]      @relation("FatherChildren")
  application     Applications[]
  location        Locations[]

  @@index([species_id])
  @@index([breed_id])
  @@index([farm_id])
  @@index([tag_number])
  @@index([health_status])
  @@map("animals")
}

model Species {
  id               Int       @id @default(autoincrement())
  name             String    @unique
  description      String
  average_lifespan Int?      @default(0)
  gestation_period Int?      @default(0)
  min_weight       Float?    @default(0)
  max_weight       Float?    @default(0)
  active           Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  animal           Animals[]
  breed            Breeds[]

  @@map("species")
}

model Breeds {
  id             Int       @id @default(autoincrement())
  name           String
  description    String
  species_id     Int
  average_weight Float?    @default(0)
  productivity   String?
  origin_country String?
  active         Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  animal         Animals[]
  species        Species   @relation(fields: [species_id], references: [id], onDelete: Cascade)

  @@index([species_id])
  @@index([name])
  @@map("breeds")
}

model Vaccines {
  id                 Int               @id @default(autoincrement())
  name               String
  target_disease     String
  manufacturer_id    Int
  batch              String
  expiration_date    DateTime
  required_doses     Int               @default(1)
  dosing_interval    Int?              @default(0)
  type_of_vaccine_id Int
  notes              String
  cost_per_dose      Float?            @default(0)
  storage_temp_min   Float?
  storage_temp_max   Float?
  active             Boolean           @default(true)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  applications       Applications[]
  manufacturer       Manufacturers     @relation(fields: [manufacturer_id], references: [id])
  type_of_vaccine    Types_of_Vaccines @relation(fields: [type_of_vaccine_id], references: [id])

  @@index([manufacturer_id])
  @@index([type_of_vaccine_id])
  @@index([expiration_date])
  @@map("vaccines")
}

model Manufacturers {
  id             Int        @id @default(autoincrement())
  name           String
  cnpj           String     @unique
  email          String     @unique
  phone          String
  address        String
  country        String
  license_number String
  website        String?
  active         Boolean    @default(true)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  vaccines       Vaccines[]

  @@map("manufacturers")
}

model Types_of_Vaccines {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  category    String?
  active      Boolean    @default(true)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  vaccines    Vaccines[]

  @@map("types_of_vaccines")
}

model Applications {
  id                         Int           @id @default(autoincrement())
  animal_id                  Int
  vaccine_id                 Int
  veterinary_id              Int
  application_date           DateTime      @default(now())
  next_application_date      DateTime?
  status_vaccine_application String        @default("COMPLETED")
  dose_number                Int           @default(1)
  application_site           String?
  batch_used                 String?
  adverse_reaction           String?
  cost                       Float?        @default(0)
  notes                      String?
  created_at                 DateTime      @default(now())
  updated_at                 DateTime      @updatedAt
  animal                     Animals       @relation(fields: [animal_id], references: [id], onDelete: Cascade)
  vaccine                    Vaccines      @relation(fields: [vaccine_id], references: [id])
  veterinary                 Veterinarians @relation(fields: [veterinary_id], references: [id], onUpdate: NoAction)

  @@index([animal_id])
  @@index([vaccine_id])
  @@index([veterinary_id])
  @@index([application_date])
  @@index([status_vaccine_application])
  @@map("applications")
}

model Locations {
  id          Int      @id @default(autoincrement())
  animal_id   Int
  latitude    Float
  longitude   Float
  altitude    Float?   @default(0)
  accuracy    Float?   @default(0)
  speed       Float?   @default(0)
  captured_at DateTime @default(now())
  device_id   String?
  battery     Int?     @default(100)
  temperature Float?
  humidity    Float?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  animal      Animals  @relation(fields: [animal_id], references: [id], onDelete: Cascade)

  @@index([animal_id])
  @@index([captured_at])
  @@index([latitude, longitude])
  @@map("locations")
}
